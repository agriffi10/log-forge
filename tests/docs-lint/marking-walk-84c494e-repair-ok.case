"""Lifecycle."""


def releasable(sink):
    """Whether this process may close a sink.

    Not every one of them names the parent: it is the parent's own stamp where ``configure()``
    left one, and ``_FOREIGN`` where :func:`_mark_inherited` wrote it, which is never a real pid
    at all.
    """

