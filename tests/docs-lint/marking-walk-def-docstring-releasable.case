@@@ file src/log_foundry/_lifecycle.py
"""Lifecycle."""


def releasable(sink):
    """Whether this process may close a sink.

    **"Unrecorded is the caller's" is only sound because a fork makes it false first.**
    In a child, :func:`_mark_inherited` records everything inherited as ``_FOREIGN`` *before*
    any handler runs, so an unrecorded sink there is one built after the fork.
    """

