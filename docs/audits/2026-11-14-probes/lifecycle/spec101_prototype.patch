+_AFTER: dict[int, tuple[object, list[list[object]]]] = {}
+"""SPEC-101 prototype: by holder id, a reference to the holder and its attached members.
+
+Each member is ``[member, closing]``. ``closing`` is ``None`` for a member kept or skipped on the
+holder's account, which stays attached for as long as the holder lives, so it is closed after every
+library close of that holder; it is the member's taken entry for a member one take ordered after
+the holder (FR-002), which is closed once and dropped."""
+
+_SKIP_REPORTED_CLOSED = os.environ.get("SPEC101_OPTION", "a") == "b"
+"""SPEC-101 prototype: option (b), skip a member whose closed guard reports a close."""
+
+_HONOUR_DECLARATION = os.environ.get("SPEC101_OPTION", "a") == "c"
+"""SPEC-101 prototype: option (c), a holder declaring log_foundry_closes_members = True is trusted."""
+
+
+def _ref(holder: object) -> object:
+    """A weak reference to *holder* where its type allows one, else the holder itself."""
+    try:
+        return weakref.ref(holder)
+    except TypeError:
+        return holder
+
+
+def _deref(ref: object) -> object | None:
+    """The holder a :func:`_ref` names, or ``None`` once it is gone."""
+    return ref() if isinstance(ref, weakref.ReferenceType) else ref
+
+
+def _entry_of(holder: object) -> list[list[object]] | None:
+    """The live attachment list of *holder*, pruning a dead entry on its id."""
+    entry = _AFTER.get(id(holder))
+    if entry is None:
+        return None
+    if _deref(entry[0]) is not holder:
+        _AFTER.pop(id(holder), None)
+        return None
+    return entry[1]
+
+
+def _prune_after() -> None:
+    """Drops every entry whose holder is gone (SPEC-101 prototype's bound)."""
+    for key, (ref, _members) in list(_AFTER.items()):
+        if _deref(ref) is None:
+            _AFTER.pop(key, None)
+
+
+def _ships_close(holder: object) -> bool:
+    """Whether *holder*'s ``close`` is the package's own, so its forward closes its members."""
+    import inspect
+
+    try:
+        close = inspect.getattr_static(type(holder), "close", None)
+    except Exception:
+        return False
+    close = getattr(close, "__func__", close)
+    return str(getattr(close, "__module__", "")).startswith("log_foundry.")
+
+
+def _attach(holder: object, member: object, closing: object = None) -> None:
+    """Records *member* to be released after each library close of *holder* (SPEC-101)."""
+    if holder is member:
+        return
+    entries = _entry_of(holder)
+    if entries is None:
+        _prune_after()
+        entries = []
+        _AFTER[id(holder)] = (_ref(holder), entries)
+    for item in entries:
+        if item[0] is member:
+            if closing is not None:
+                item[1] = closing
+            return
+    entries.append([member, closing])
+
+
+def _unattach(holder: object, member: object) -> None:
+    """Drops *member* from *holder*'s persistent attachments, when it moves to another holder."""
+    entries = _entry_of(holder)
+    if entries is not None:
+        entries[:] = [item for item in entries if item[0] is not member or item[1] is not None]
+
+
+def _take_deferred(holder: object) -> list[tuple[object, object]]:
+    """Removes and returns the one-shot members of *holder*, those carrying a taken entry."""
+    entries = _entry_of(holder)
+    if entries is None:
+        return []
+    taken = [(item[0], item[1]) for item in entries if item[1] is not None]
+    entries[:] = [item for item in entries if item[1] is None]
+    return taken
+
+
+def _caller_holder_for(sink: object, roots: list[object]) -> object | None:
+    """The closest holder whose close is not the package's, among *roots* and their graphs."""
+    best: object | None = None
+    best_size = 0
+    seen: set[int] = set()
+    for root in roots:
+        for node in _installed_graph(root).values():
+            if id(node) in seen or node is sink or _ships_close(node):
+                continue
+            seen.add(id(node))
+            graph = _installed_graph(node)
+            if graph.get(id(sink)) is not sink:
+                continue
+            if best is None or len(graph) < best_size:
+                best, best_size = node, len(graph)
+    return best
