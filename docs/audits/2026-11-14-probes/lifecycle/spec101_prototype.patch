+def _order_after(taken: list[Sink]) -> dict[int, object]:
+    """For each taken sink lying strictly beneath another taken one, its closest such holder."""
+    if len(taken) < 2:
+        return {}
+    graphs = {id(sink): _installed_graph(sink) for sink in taken}
+    order: dict[int, object] = {}
+    for member in taken:
+        best = None
+        for holder in taken:
+            if holder is member or _ships_close(holder):
+                continue
+            if graphs[id(holder)].get(id(member)) is not member:
+                continue
+            if graphs[id(member)].get(id(holder)) is holder:
+                continue
+            if best is None or len(graphs[id(holder)]) < len(graphs[id(best)]):
+                best = holder
+        if best is not None:
+            order[id(member)] = best
+    return order
+
