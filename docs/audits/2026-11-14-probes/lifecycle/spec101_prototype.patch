+
+
+def _attach_kept(root: object, sink: object) -> None:
+    """Attaches a sink a swap kept to the closest caller's holder of it in the installed graph."""
+    holder = _caller_holder_for(sink, [root])
+    if holder is not None:
+        _attach(holder, sink)
+
+
+def _attach_skipped(keep: "_Keep", sink: object, previous: object | None = None) -> None:
+    """Attaches a member a keep spared to the caller's holder on whose account it was spared."""
+    root = getattr(keep, "root", None)
+    holder: object | None = None
+    if keep.kept.get(id(sink)) is sink:
+        if root is not None:
+            holder = _caller_holder_for(sink, [root])
+    elif keep.remaining and keep.remaining_graph().get(id(sink)) is sink:
+        if any(item is sink for item in keep.remaining):
+            holder = None
+        else:
+            holder = _caller_holder_for(sink, list(keep.remaining))
+    else:
+        return
+    if previous is not None and holder is not previous:
+        _unattach(previous, sink)
+    if holder is not None:
+        _attach(holder, sink)
+
+
+def _reports_closed(sink: object) -> bool:
+    """Option (b): whether a shipped closed guard on *sink* reports a close has begun."""
+    from log_foundry.sinks._guard import ClosedGuard
