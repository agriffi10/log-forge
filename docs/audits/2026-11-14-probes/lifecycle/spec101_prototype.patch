+
+def _release_after(holder: object, keep: "_Keep") -> None:
+    """Releases each member attached to *holder*, in sequence, after its close (SPEC-101).
+
+    A persistent member stays attached; a one-shot member is dropped. A ``BaseException`` from a
+    member's close puts back every one-shot member not yet closed, its entry discharged, and
+    propagates."""
+    entries = _entry_of(holder)
+    if not entries:
+        return
+    pending = [(item[0], item[1]) for item in entries]
+    entries[:] = [item for item in entries if item[1] is None]
+    declared = _HONOUR_DECLARATION and type(holder).__dict__.get("log_foundry_closes_members") is True
+    index = 0
+    try:
+        for index, (member, closing) in enumerate(pending):
+            if declared:
+                if closing is not None:
+                    _state._closes.finish(member, closing)
+                continue
+            if closing is None:
+                if _state._closes.owes(member) or _state._closes.in_flight(member):
+                    continue
+                if keep.spares(member):
+                    _attach_skipped(keep, member, previous=holder)
+                    continue
+            if _SKIP_REPORTED_CLOSED and _reports_closed(member):
+                if closing is not None:
+                    _state._closes.finish(member, closing)
+                continue
+            try:
+                release(member, closing=closing, keeping=keep)
+            except Exception as exc:
+                _diag.absorbed(
+                    "closing a sink after the wrapper that holds it",
+                    exc,
+                    "it may still hold its resources",
+                )
+    except BaseException:
+        with _state._lock:
+            for member, closing in pending[index + 1 :]:
+                if closing is not None:
+                    _state._closes.put_back(member, closing)
+        raise
+
