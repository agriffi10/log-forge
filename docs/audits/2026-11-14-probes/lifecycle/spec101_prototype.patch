+_ARMED: dict[int, object] = {}
+"""SPEC-101 prototype: by id, a reference to every sink the library has armed as a root, which is
+what "the library wrote to it" means; the build keeps this on the sink's ownership entry."""
+
+
+def _was_armed(sink: object) -> bool:
+    """Whether the library has armed *sink* as a root in this process (SPEC-101 prototype)."""
+    ref = _ARMED.get(id(sink))
+    return ref is not None and _deref(ref) is sink
+
+
+def _attach_written(root: object, graph: Mapping[int, object]) -> None:
+    """Attaches every sink in *root*'s graph the library wrote to, to its closest caller holder."""
+    for key, ref in list(_ARMED.items()):
+        if _deref(ref) is None:
+            _ARMED.pop(key, None)
+    for member in list(graph.values()):
+        if member is root or not _was_armed(member):
+            continue
