index 0000000..719b7cb
--- /dev/null
+++ b/scripts/model-soak-report.py
@@ -0,0 +1,181 @@
+"""The nightly model soak's seeds and its report (SPEC-099 prototype)."""
+
+from __future__ import annotations
+
+import argparse
+import pathlib
+import sys
+import xml.etree.ElementTree as ET
+from collections import Counter
+
+sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "tests"))
+
+import soak_known  # noqa: E402
+from soak_ceilings import ceiling_of  # noqa: E402
+from model_oracles import FORMS_SOAKED, parse_seeds, rerun_command  # noqa: E402
+
+WINDOW = 5000
+"""Seeds one night soaks: 15,000 items, about 280 s on the 4-CPU stand-in (SPEC-099 Evidence)."""
+
+WINDOWS = 30
+"""Windows the nights rotate through before seed 0 comes round again."""
+
+MAX_SEEDS = 10_000
+"""The most seeds a dispatch may ask for.
+
+30 minutes of job less 180 s of install and one hung item's 600 s guard leaves 1,020 s; 10,000
+seeds is 561 s at the stand-in's 56 ms a seed, and 842 s at half again that, so it fits.
+"""
+
+PULL_REQUEST_SEEDS = "0-99"
+"""What a pull request touching the soak runs."""
+
+SOAK = "test_soak_the_close_count_under_concurrency["
+WIRING = (
+    "test_the_soak_is_wired[emit]",
+    "test_the_soak_is_wired[deliver]",
+    "test_the_soak_is_wired[http]",
+    "test_the_soak_records_the_worker_path",
+    "test_a_name_the_soak_cannot_wrap_fails_it[_lifecycle._CloseRegistry.arm]",
+    "test_a_name_the_soak_cannot_wrap_fails_it[_lifecycle._CloseRegistry.take]",
+    "test_a_name_the_soak_cannot_wrap_fails_it[log_foundry.api._note_orphan_emit]",
+    "test_a_name_the_soak_cannot_wrap_fails_it[_lifecycle._get_worker]",
+)
+KNOWN_PREFIX = "known soak finding:"
+
+
+def normalise(seeds: tuple[int, ...]) -> str:
+    """Returns seeds as comma-separated ranges, digits, commas and hyphens only."""
+    parts: list[str] = []
+    start = prev = None
+    for seed in seeds:
+        if prev is not None and seed == prev + 1:
+            prev = seed
+            continue
+        if start is not None:
+            parts.append(str(start) if start == prev else f"{start}-{prev}")
+        start = prev = seed
+    if start is not None:
+        parts.append(str(start) if start == prev else f"{start}-{prev}")
+    return ",".join(parts)
+
+
+def seeds(event: str, asked: str, run_number: int) -> str:
+    """Returns the seeds a run soaks: a dispatch's, a pull request's, or the run number's window."""
+    if asked:
+        written = 0
+        for item in asked.split(","):
+            low, _, high = item.strip().partition("-")
+            if (
+                low.isascii()
+                and low.isdigit()
+                and (not high or (high.isascii() and high.isdigit()))
+            ):
+                written += max(int(high or low) - int(low) + 1, 0)
+        if written > MAX_SEEDS:
+            raise ValueError(f"seeds={asked!r} writes {written} seeds; at most {MAX_SEEDS}")
+        chosen = parse_seeds(asked)
+        return normalise(chosen)
+    if event == "pull_request":
+        return PULL_REQUEST_SEEDS
+    start = (run_number % WINDOWS) * WINDOW
+    return f"{start}-{start + WINDOW - 1}"
+
+
+def report(xml: pathlib.Path, seeds_value: str) -> tuple[str, int]:
+    """Returns the run's summary in Markdown and the exit status the floor and ceilings set."""
+    expected = len(parse_seeds(seeds_value)) * len(FORMS_SOAKED)
+    soaked, passed, unexplained = 0, 0, []
+    known: Counter[str] = Counter()
+    new: list[tuple[str, str]] = []
+    wiring: dict[str, bool] = {}
+    for case in ET.parse(xml).getroot().iter("testcase"):
+        name = case.get("name", "")
+        failure = case.find("failure")
+        if failure is None:
+            failure = case.find("error")
+        skipped = case.find("skipped")
+        if name in WIRING:
+            wiring[name] = failure is None and skipped is None
+        if not name.startswith(SOAK):
+            continue
+        soaked += 1
+        props = {p.get("name"): p.get("value") for p in case.iter("property")}
+        if failure is not None:
+            first = (failure.get("message") or "").splitlines()[:1]
+            seed = int(name.rsplit("seed", 1)[1].rstrip("]"))
+            node = f"tests/test_invariants_model.py::{name}"
+            new.append((name, " ".join(first) + f" -- {rerun_command(node, seed, soak=True)}"))
+        elif skipped is not None:
+            message = skipped.get("message") or ""
+            shapes = [s for s in (props.get("soak_known") or "").split(",") if s]
+            if (
+                skipped.get("type") == "pytest.xfail"
+                and message.startswith(KNOWN_PREFIX)
+                and shapes
+            ):
+                known.update(shapes)
+            else:
+                unexplained.append(name)
+        else:
+            passed += 1
+    lines = [f"## Model soak: seeds {seeds_value}", ""]
+    lines.append(f"- soak items run: {soaked} of {expected}")
+    lines.append(f"- clean: {passed}; known: {sum(known.values())}; new: {len(new)}")
+    lines.append(f"- wiring items passed: {sum(wiring.values())} of {len(WIRING)}")
+    status = 0
+    rows = {k.name: k for k in soak_known.KNOWN}
+    if known:
+        lines += ["", "### Known (each an open item of `docs/architecture.md` §12)", ""]
+        for shape, count in known.most_common():
+            row = rows.get(shape)
+            item = row.item if row else "(no such row)"
+            lines.append(f"- {count} x {shape}, ceiling {ceiling_of(shape)}: {item}")
+            if row is None or count > ceiling_of(shape):
+                lines.append(f"**Ceiling broken:** {shape} held {count} items.")
+                status = 1
+    if new:
+        lines += ["", "### New", ""]
+        lines += [f"- `{name}`: {text}" for name, text in new]
+    if soaked != expected:
+        lines += ["", f"**Floor broken:** {soaked} soak items ran where {expected} were asked for."]
+        status = 1
+    if unexplained:
+        lines += [
+            "",
+            f"**Floor broken:** {len(unexplained)} soak items were skipped or marked "
+            f"expected-to-fail without a known shape: {unexplained[:5]}",
+        ]
+        status = 1
+    if set(wiring) != set(WIRING) or not all(wiring.values()):
+        lines += ["", "**Wiring:** the soak's wiring items did not all run and pass."]
+        status = 1
+    return "\n".join(lines) + "\n", status
+
+
+def main() -> int:
+    """Runs one subcommand."""
+    parser = argparse.ArgumentParser()
+    sub = parser.add_subparsers(dest="command", required=True)
+    pick = sub.add_parser("seeds")
+    pick.add_argument("--event", default="")
+    pick.add_argument("--asked", default="")
+    pick.add_argument("--run-number", type=int, required=True)
+    rep = sub.add_parser("report")
+    rep.add_argument("xml", type=pathlib.Path)
+    rep.add_argument("seeds")
+    rep.add_argument("--summary", type=pathlib.Path)
+    args = parser.parse_args()
+    if args.command == "seeds":
+        print(seeds(args.event, args.asked, args.run_number))
+        return 0
+    text, status = report(args.xml, args.seeds)
+    print(text)
+    if args.summary is not None:
+        with args.summary.open("a", encoding="utf-8") as out:
+            out.write(text)
+    return status
+
+
+if __name__ == "__main__":
+    sys.exit(main())
