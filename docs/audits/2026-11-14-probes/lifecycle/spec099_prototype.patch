diff --git a/tests/soak_ceilings.py b/tests/soak_ceilings.py
new file mode 100644
index 0000000..1b66f08
--- /dev/null
+++ b/tests/soak_ceilings.py
@@ -0,0 +1,20 @@
+"""SPEC-099's nightly ceilings for the known soak shapes, kept apart from the clearing files."""
+
+UNMEASURED_CEILING = 3
+"""A row with no measured ceiling: its first nights may hold three such items before the run is red.
+
+A clearing pull request adds a row and cannot touch this file, so a new shape has no rate yet.
+Three lets the night that filed it recur at a similar count; anything more needs a reviewed PR
+that measures it and writes its ceiling below.
+"""
+
+CEILINGS: dict[str, int] = {
+    "swap-arms-a-sink-a-shutdown-took": 20,  # measured at eda19f32: most 8 a night; x2 under, x3 over
+    "orphan-write-after-close": 25,  # measured at eda19f32: most 10 a night; x2 under, x3 over
+}
+"""Each measured ceiling, with its derivation and the commit it was measured at beside it."""
+
+
+def ceiling_of(name: str) -> int:
+    """Returns a known row's nightly ceiling."""
+    return CEILINGS.get(name, UNMEASURED_CEILING)
diff --git a/tests/soak_known.py b/tests/soak_known.py
new file mode 100644
index 0000000..a59e99a
--- /dev/null
+++ b/tests/soak_known.py
@@ -0,0 +1,227 @@
+"""SPEC-099's known soak findings: each red soak shape an open item of ``architecture.md`` §12 records."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+
+from model_oracles import (
+    Arm,
+    CloseBroken,
+    Closes,
+    Note,
+    SinkEvent,
+    Take,
+    Write,
+    check_late_write,
+    check_unowed_repeat,
+    owed_between,
+    take_of_each_close,
+)
+
+if TYPE_CHECKING:
+    from collections.abc import Sequence
+
+
+@dataclass(frozen=True)
+class Known:
+    """A soak shape an open item records, so a red soak item of that shape alone is expected.
+
+    Attributes:
+      name: A short name, printed in the run's summary.
+      item: The bold lead of a bullet under ``### Open`` in ``docs/architecture.md`` §12.
+      kind: The signature it explains: ``"repeat"`` or ``"late-write"``.
+    """
+
+    name: str
+    item: str
+    kind: str
+
+
+SWAP_ARM = Known(
+    "swap-arms-a-sink-a-shutdown-took",
+    "A sink a swap installs is closed twice with nothing written between when a concurrent "
+    "`shutdown()` took it before the swap decided",
+    "repeat",
+)
+ORPHAN_LATE_WRITE = Known(
+    "orphan-write-after-close",
+    "An orphan log that passed its owed check before a `shutdown()` took its sink writes after "
+    "the close, and the sink is owed nothing",
+    "late-write",
+)
+KNOWN: tuple[Known, ...] = (SWAP_ARM, ORPHAN_LATE_WRITE)
+"""Every known shape; a row whose item has left ``### Open`` fails the default suite."""
+
+FILED_NIGHTS: dict[str, str] = {}
+"""Each scheduled night a clearing pull request filed: ``"<run id>-<attempt>"`` to the §12 lead.
+
+One entry per line, four spaces, the quoted key, a colon, the quoted lead and a comma: the PR
+queue reads this file on ``origin/main`` as text, and a night is cleared only by its own entry.
+"""
+
+
+def unowed_pairs(events: Sequence[SinkEvent]) -> list[tuple[int | None, int | None]]:
+    """Returns the take indices of each pair of closes the unowed-repeat rule reports.
+
+    Args:
+      events: One sink's events, in the order recorded.
+
+    Returns:
+      ``(first take, second take)`` for each consecutive pair of closes at one count with nothing
+      between their takes that owes the second.
+
+    Raises:
+      None.
+    """
+    closes = [event for event in events if hasattr(event, "count")]
+    owners = take_of_each_close(events)
+    pairs: list[tuple[int | None, int | None]] = []
+    for first, second, a, b in zip(closes, closes[1:], owners, owners[1:], strict=False):
+        if first.count != second.count:  # type: ignore[attr-defined]
+            continue
+        if a is not None and b is not None:
+            low, high = sorted((a, b))
+            if owed_between(events[low + 1 : high]):
+                continue
+        pairs.append((a, b))
+    return pairs
+
+
+def is_swap_arm(events: Sequence[SinkEvent]) -> bool:
+    """Whether every unowed repeat is §12's swap arm after a ``shutdown()``'s take.
+
+    The first close's take is ``_close_owed``'s, a ``shutdown()`` or the exit drain, and the
+    only owing record between the two takes is ``_swap_sink`` arming the sink it installs.
+
+    Args:
+      events: One sink's events, in the order recorded.
+
+    Returns:
+      Whether the sink's every unowed repeat has that shape.
+
+    Raises:
+      None.
+    """
+    pairs = unowed_pairs(events)
+    if not pairs:
+        return False
+    for a, b in pairs:
+        if a is None or b is None:
+            return False
+        first = events[min(a, b)]
+        if not isinstance(first, Take) or first.by != "_close_owed":
+            return False
+        between = events[min(a, b) + 1 : max(a, b)]
+        arms = [e for e in between if isinstance(e, Arm) and not e.by_writer]
+        if not arms or any(e.by != "_swap_sink" for e in arms):
+            return False
+    return True
+
+
+def is_orphan_late_write(events: Sequence[SinkEvent], closes: Closes) -> bool:
+    """Whether every write after the sink's last close returned is §12's orphan late write.
+
+    Each such write is an orphan log's, on a caller's thread, whose ``_note_orphan_emit`` entry
+    came before the sink's last take, and nothing armed the sink after that take.
+
+    Args:
+      events: One sink's events, in the order recorded.
+      closes: The sink's close record.
+
+    Returns:
+      Whether the late writes have that shape.
+
+    Raises:
+      None.
+    """
+    if not closes.at_return or closes.writes <= closes.at_return[-1]:
+        return False
+    takes = [i for i, e in enumerate(events) if isinstance(e, Take)]
+    writes = [i for i, e in enumerate(events) if isinstance(e, Write)]
+    late = closes.writes - closes.at_return[-1]
+    if not takes or len(writes) < late:
+        return False
+    last_take = takes[-1]
+    if any(isinstance(e, Arm) for e in events[last_take + 1 :]):
+        return False
+    for index in writes[-late:]:
+        thread = events[index].thread  # type: ignore[union-attr]
+        notes = [
+            j for j in range(index) if isinstance(events[j], Note) and events[j].thread == thread
+        ]  # type: ignore[union-attr]
+        if thread.startswith("log-foundry-") or not notes or notes[-1] > last_take:
+            return False
+    return True
+
+
+def explain(signatures: Sequence[str], events: Sequence[SinkEvent], closes: Closes) -> list[Known]:
+    """Returns the known shape behind each signature of one sink, or ``[]`` if any is new.
+
+    Args:
+      signatures: The sink's ``CloseBroken:<kind>@<count>`` signatures.
+      events: Its events.
+      closes: Its close record.
+
+    Returns:
+      The shapes, one per kind, or an empty list when a signature has none.
+
+    Raises:
+      None.
+    """
+    found: list[Known] = []
+    for signature in signatures:
+        kind = signature.removeprefix("CloseBroken:").split("@", 1)[0]
+        if kind == "repeat" and is_swap_arm(events):
+            shape = SWAP_ARM
+        elif kind == "late-write" and is_orphan_late_write(events, closes):
+            shape = ORPHAN_LATE_WRITE
+        else:
+            return []
+        if shape not in found:
+            found.append(shape)
+    return found
+
+
+def reason(known: Sequence[Known]) -> str:
+    """Returns the one-line reason a known red soak item reports.
+
+    Args:
+      known: The shapes.
+
+    Returns:
+      ``known soak finding: <name> (§12: <item>); ...``.
+
+    Raises:
+      None.
+    """
+    return "known soak finding: " + "; ".join(f"{k.name} (§12: {k.item})" for k in known)
+
+
+def explain_run(sinks: Sequence[tuple[Sequence[SinkEvent], Closes]]) -> list[Known]:
+    """Returns the known shapes behind a red soak run, or ``[]`` if any sink's finding is new.
+
+    Args:
+      sinks: Each sink's events and close record.
+
+    Returns:
+      The shapes, or an empty list when the run has no finding or one with no known shape.
+
+    Raises:
+      None.
+    """
+    found: list[Known] = []
+    for events, closes in sinks:
+        signatures: list[str] = []
+        for check, arg in ((check_unowed_repeat, events), (check_late_write, closes)):
+            try:
+                check(arg)  # type: ignore[operator]
+            except CloseBroken as exc:
+                signatures.extend(exc.signatures)
+        if not signatures:
+            continue
+        shapes = explain(signatures, events, closes)
+        if not shapes:
+            return []
+        found.extend(shape for shape in shapes if shape not in found)
+    return found
