+
+# clearing_range <from> <to>  0 when the commits from..to in $PWD change something, and only
+#             tests/soak_known.py and docs/architecture.md, each left a regular file; 1 otherwise.
+#             Names are read NUL-delimited and compared whole, renames as a deletion and an
+#             addition, with no user diff setting able to change what is read.
+clearing_range() {
+  local meta path om nm rest n=0
+  while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
+    n=$((n+1))
+    read -r om nm rest <<< "${meta#:}"
