@@ -0,0 +1,227 @@
+"""SPEC-099 prototype: the known shapes' predicates, near misses, and the write-site roster."""
+
+from __future__ import annotations
+
+import ast
+import pathlib
+import re
+
+import pytest
+
+import soak_ceilings
+import soak_known
+from model_oracles import Arm, Close, Note, Take, Write
+
+T1, T2, MT, WK = "Thread-1 (runner)", "Thread-2 (runner)", "MainThread", "log-foundry-worker"
+
+
+class _C:
+    def __init__(self, writes: int, at_return: list[int]) -> None:
+        self.writes, self.at_return = writes, at_return
+
+
+def _close(n: int, t: str = T1) -> Close:
+    return Close(n, t, 0.0)
+
+
+def _names(
+    events: list[object], writes: int | None = None, at_return: list[int] | None = None
+) -> list[str]:
+    if writes is None:
+        writes = sum(isinstance(e, Write) for e in events)
+    if at_return is None:
+        at_return = [e.count for e in events if isinstance(e, Close)]
+    return [k.name for k in soak_known.explain_run([(events, _C(writes, at_return))])]
+
+
+SHAPE_A = [Note(T1), Arm(True, "_arm_and_hand"), Write(T1), Take("_close_owed"), _close(1)]
+
+
+@pytest.mark.parametrize(
+    ("tail", "expected"),
+    [
+        (
+            [Arm(False, "_swap_sink"), Take("_close_owed"), _close(1)],
+            ["swap-arms-a-sink-a-shutdown-took"],
+        ),
+        (
+            [Arm(False, "_swap_sink"), Take("_swap_sink"), _close(1)],
+            ["swap-arms-a-sink-a-shutdown-took"],
+        ),
+        (
+            [
+                Arm(False, "_swap_sink"),
+                Take("_close_owed"),
+                _close(1),
+                Arm(False, "_swap_sink"),
+                Take("_close_owed"),
+                _close(1),
+            ],
+            ["swap-arms-a-sink-a-shutdown-took"],
+        ),
+        ([Take("_close_owed"), _close(1)], []),
+        ([Arm(False, "_some_new_rearm"), Take("_close_owed"), _close(1)], []),
+        (
+            [
+                Arm(False, "_swap_sink"),
+                Arm(False, "_some_new_rearm"),
+                Take("_close_owed"),
+                _close(1),
+            ],
+            [],
+        ),
+    ],
+    ids=[
+        "swap",
+        "swap-then-a-swaps-take",
+        "triple-close",
+        "no-arm",
+        "unknown-arm-caller-only",
+        "swap-arm-plus-unknown-arm-caller",
+    ],
+)
+def test_the_swap_shape(tail: list[object], expected: list[str]) -> None:
+    """The first take is ``_close_owed``'s and every non-writer arm between the takes is the swap's."""
+    assert _names(SHAPE_A + tail) == expected
+
+
+def test_the_swap_shape_needs_a_shutdowns_first_take() -> None:
+    """#339's shape, a sink change's take first, is never known."""
+    events = [
+        Note(T1),
+        Arm(True, "_arm_and_hand"),
+        Write(T1),
+        Take("_swap_sink"),
+        _close(1),
+        Arm(False, "_swap_sink"),
+        Take("_swap_sink"),
+        _close(1),
+    ]
+    assert _names(events) == []
+
+
+@pytest.mark.parametrize(
+    ("events", "writes", "at_return", "expected"),
+    [
+        (
+            [
+                Note(T1),
+                Arm(True, "_arm_and_hand"),
+                Write(T1),
+                Note(T2),
+                Take("_close_owed"),
+                _close(1),
+                Write(T2),
+            ],
+            2,
+            [1],
+            ["orphan-write-after-close"],
+        ),
+        (
+            [Arm(True, "_get_worker"), Write(WK), Take("_close_owed"), _close(1), Write(WK)],
+            2,
+            [1],
+            [],
+        ),
+        (
+            [
+                Note(T1),
+                Arm(True, "_arm_and_hand"),
+                Write(T1),
+                Take("_close_owed"),
+                _close(1),
+                Note(T2),
+                Write(T2),
+            ],
+            2,
