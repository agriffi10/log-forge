+        "worker-late-write",
+        "note-after-the-last-take",
+        "arm-after-the-last-take",
+    ],
+)
+def test_the_orphan_late_write_shape(
+    events: list[object], writes: int, at_return: list[int], expected: list[str]
+) -> None:
+    """A late write is the orphan item's only on a caller's thread whose entry preceded the last take."""
+    assert _names(events, writes, at_return) == expected
+
+
+def test_a_run_with_one_unknown_sink_is_not_known() -> None:
+    """One sink of a new shape makes the whole run new, beside a known one."""
+    known = SHAPE_A + [Arm(False, "_swap_sink"), Take("_close_owed"), _close(1)]
+    new = SHAPE_A + [Take("_close_owed"), _close(1)]
+    c = _C(1, [1, 1])
+    assert soak_known.explain_run([(known, c), (new, c)]) == []
+
+
+def test_every_ceiling_names_a_row_and_carries_its_derivation() -> None:
+    """Each measured ceiling names a known row and has its measurement and commit on its line."""
+    names = {k.name for k in soak_known.KNOWN}
+    assert set(soak_ceilings.CEILINGS) <= names, set(soak_ceilings.CEILINGS) - names
+    lines = pathlib.Path(soak_ceilings.__file__).read_text(encoding="utf-8").splitlines()
