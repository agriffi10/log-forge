+    [ "$path" = tests/soak_known.py ] || [ "$path" = docs/architecture.md ] || return 1
+  done < <(git -C "$PWD" -c core.quotepath=false diff --raw -z --no-abbrev --no-renames \
+             --no-ext-diff --no-relative --no-color --no-textconv "$1" "$2" 2>/dev/null)
