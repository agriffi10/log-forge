+# filed <run id>-<attempt>  0 when tests/soak_known.py on origin/main files that attempt in
+#             FILED_NIGHTS, one entry a line as soak_known.py writes it; 1 when it does not; 2 when
+#             origin/main could not be read. The record is the night's own key, so no clock is
+#             compared: a filing cannot be made before the run exists, nor carried by the tree the
+#             night tested. Fetched into origin/main only, never FETCH_HEAD, which several worktrees
+#             would race on.
+filed() {
+  local text
+  git -C "$REPO" fetch -q --no-write-fetch-head origin "+refs/heads/$MAIN:refs/remotes/origin/$MAIN" 2>/dev/null || return 2
+  text="$(git -C "$REPO" show "origin/$MAIN:tests/soak_known.py" 2>/dev/null)" || return 2
+  printf '%s\n' "$text" | grep -qE "^    \"$1\": \".+\",\$" && return 0
+  return 1
