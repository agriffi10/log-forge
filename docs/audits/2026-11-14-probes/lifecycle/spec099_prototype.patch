+def owed_between(between: Sequence[SinkEvent]) -> bool:
+    """Whether a stretch between two closes' takes holds what owes the sink its second close.
+
+    SPEC-045 owes a second close to a sink written after its first close was taken. Two records
+    say so: a writer's arm, and an orphan log that entered ``_note_orphan_emit`` after the first
+    take and wrote before the second, which makes no arm of its own when another arm already put
+    the sink back in the record. A write whose log entered before the first take is the race of
+    the orphan-log item in ``docs/architecture.md`` §12, and owes nothing here (SPEC-099).
+
+    Args:
+      between: One sink's events strictly between the two takes, in the order recorded.
+
+    Returns:
+      Whether the second close is owed.
+
+    Raises:
+      None.
+    """
+    entered: set[str] = set()
+    for event in between:
+        if isinstance(event, Arm) and event.by_writer:
+            return True
+        if isinstance(event, Note):
+            entered.add(event.thread)
+        elif isinstance(event, Write) and event.thread in entered:
+            return True
+    return False
+
