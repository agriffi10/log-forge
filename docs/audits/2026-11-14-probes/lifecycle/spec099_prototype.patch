+# --- the nightly soak's verdict (SPEC-099) ----------------------------------------------------
+SOAK_WORKFLOW="Model soak"
+SOAK_FILE="model-soak.yml"
+SOAK_LOOKBACK=30        # scheduled runs read back through nights with no verdict: a month
+SOAK_QUIET_HOURS=48     # a verdict older than this is named in turn's answer
+
+# soak_verdict  0 nothing blocks · 4 the newest scheduled night with a verdict failed, and no
+#               clearing commit answers it · 3 the verdict could not be read. Prints
+#               "<state> <run id or none> <time>", the time being the blocking attempt's completion
+#               when it blocks, and otherwise the verdict's.
+#
+# Only SCHEDULED runs carry a verdict: a dispatch or a pull request's run is someone's experiment.
+# The newest run with a verdict is read, on any sha, so a merge made while the night ran cannot
+# step past it. Every attempt is read through the API, because `gh run list` reports only the
+# latest attempt's conclusion and status: an attempt that concluded failure or timed_out blocks,
+# whatever a re-run did later, and a re-run still in progress hides none of the attempts before
+# it. A run is listed whatever its status for that reason. A night whose every attempt has no
+# verdict yet or none at all (in progress, cancelled, startup_failure, action_required, skipped,
+# neutral, stale) is passed over for the one before it.
+soak_verdict() {
+  [ -x "$Q/soak-verdict" ] && { "$Q/soak-verdict"; return $?; }
+  local runs id attempts head n a c t seen blocked when last bad
+  runs="$( cd "$REPO" && gh run list --workflow "$SOAK_FILE" --event schedule \
+             --limit "$SOAK_LOOKBACK" --json databaseId,attempt,headSha \
+             --jq '.[] | "\(.databaseId) \(.attempt) \(.headSha)"' )" || { echo "3 unreadable"; return 3; }
+  while read -r id attempts head; do
+    [ -n "$id" ] || continue
+    case "$attempts" in ''|*[!0-9]*) echo "3 $id"; return 3 ;; esac
+    seen=0; blocked=0; when=""; last=""; bad=""
+    for (( n=1; n<=attempts; n++ )); do
+      a="$( cd "$REPO" && gh api "repos/{owner}/{repo}/actions/runs/$id/attempts/$n" \
+              --jq '"\(.conclusion) \(.updated_at)"' )" || { echo "3 $id"; return 3; }
+      c="${a%% *}"; t="${a#* }"
+      case "$c" in
+        failure|timed_out) seen=1; blocked=1; when="$t"; last="$t"; bad="$n" ;;
+        success)           seen=1; last="$t" ;;
