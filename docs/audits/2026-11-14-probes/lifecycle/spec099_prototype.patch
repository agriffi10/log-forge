index 0000000..d2868f4
--- /dev/null
+++ b/tests/test_model_soak_workflow.py
@@ -0,0 +1,248 @@
+"""SPEC-099 prototype: the nightly soak's workflow, its seeds and its report cannot rot unseen."""
+
+from __future__ import annotations
+
+import importlib.util
+import os
+import pathlib
+import re
+import subprocess
+import sys
+import tracemalloc
+
+import pytest
+
+import soak_ceilings
+import soak_known
+from test_model_oracles import open_item_leads
+
+_ROOT = pathlib.Path(__file__).resolve().parent.parent
+_WORKFLOW = _ROOT / ".github" / "workflows" / "model-soak.yml"
+_SPEC = importlib.util.spec_from_file_location(
+    "model_soak_report", _ROOT / "scripts" / "model-soak-report.py"
+)
+assert _SPEC and _SPEC.loader
+report_mod = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(report_mod)
+
+
+def test_every_known_shape_names_an_open_item() -> None:
+    """A known shape whose §12 item has left ``### Open`` fails here, so its row goes with it."""
+    leads = open_item_leads()
+    missing = [k.name for k in soak_known.KNOWN if " ".join(k.item.split()) not in leads]
+    assert not missing, missing
+
+
+def _text() -> str:
+    return _WORKFLOW.read_text(encoding="utf-8")
+
+
+def test_the_workflow_runs_nightly_and_switches_the_soak_on() -> None:
+    """The schedule, the switch, the run number and the report step are where the soak needs them."""
+    text = _text()
+    assert re.search(r'^  schedule:\n    - cron: "37 9 \* \* \*"\n', text, re.MULTILINE), "cron"
+    assert "\n  workflow_dispatch:\n" in text, "dispatch"
+    assert re.search(r'^          LOG_FOUNDRY_MODEL_SOAK: "1"$', text, re.MULTILINE), "switch"
+    assert "RUN_NUMBER: ${{ github.run_number }}" in text, "run number"
+    assert "ASKED: ${{ inputs.seeds }}" in text and "run: |" in text, "dispatch input via env"
+    expressions = [line for line in text.splitlines() if "${{" in line]
+    allowed = re.compile(r"^(  group: model-soak-\$\{\{.*|          [A-Z_]+: \$\{\{ [\w.]+ \}\})$")
+    assert all(allowed.match(line) for line in expressions), "an expression outside env"
+    assert re.search(r"if: always\(\)\n.*\n.*\n.*report soak\.xml \"\$SEEDS\" --summary", text), (
+        "report"
+    )
+    assert "group: model-soak-${{" in text, "concurrency prefix"
+
+
+def test_the_workflow_is_hardened() -> None:
+    """Read-only, no persisted token, every action pinned with its version comment, the floor Python."""
+    text = _text()
+    assert re.findall(r"^permissions:\n  contents: read\n", text, re.MULTILINE), "permissions"
+    assert "write" not in text.split("\njobs:", 1)[0].split("permissions:", 1)[1], "write scope"
+    assert "persist-credentials: false" in text, "token"
+    for uses in re.findall(r"uses: (\S+)(.*)", text):
+        ref, comment = uses
+        assert ref.startswith("./") or re.fullmatch(r"[\w.-]+/[\w.-]+@[0-9a-f]{40}", ref), ref
+        assert ref.startswith("./") or re.fullmatch(r" # v\d+\.\d+\.\d+", comment), comment
+    assert 'python-version: "3.12"' in text, "python"
+
+
+def test_the_workflows_selection_collects_the_soak_and_its_wiring() -> None:
+    """The workflow's own pytest arguments select every soak item and exactly the wiring set."""
+    command = re.search(r'run: poetry run pytest (tests/\S+) -k "([^"]+)"', _text())
+    assert command, "no pytest step"
+    env = dict(os.environ, LOG_FOUNDRY_MODEL_SOAK="1", LOG_FOUNDRY_MODEL_SEEDS="0-1")
+    out = subprocess.run(  # noqa: S603
+        [
+            sys.executable,
+            "-B",
+            "-m",
+            "pytest",
+            command.group(1),
+            "-k",
+            command.group(2),
+            "--collect-only",
+            "-q",
+            "-n",
+            "0",
+            "-p",
+            "no:cacheprovider",
+        ],
+        cwd=_ROOT,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=120,
+        check=False,
+    ).stdout
+    ids = [line.split("::", 1)[1] for line in out.splitlines() if "::" in line]
+    soak = [i for i in ids if i.startswith(report_mod.SOAK)]
+    assert len(soak) == 6, ids
+    assert sorted(set(ids) - set(soak)) == sorted(report_mod.WIRING), ids
+
+
+def test_the_seeds_are_the_run_numbers_window_and_a_dispatch_is_bounded() -> None:
+    """A re-run keeps its run number and so its seeds; a dispatch is parsed, bounded and normalised."""
+    assert report_mod.seeds("schedule", "", 1) == "5000-9999"
+    assert report_mod.seeds("schedule", "", 31) == report_mod.seeds("schedule", "", 1)
+    assert report_mod.seeds("workflow_dispatch", "", 2) == "10000-14999"
+    assert report_mod.seeds("pull_request", "", 2) == "0-99"
+    assert report_mod.seeds("workflow_dispatch", "1,\n2, 4", 2) == "1-2,4"
+    assert report_mod.seeds("workflow_dispatch", f"0-{report_mod.MAX_SEEDS - 1}", 2)
+    with pytest.raises(ValueError, match="at most"):
+        report_mod.seeds("workflow_dispatch", f"0-{report_mod.MAX_SEEDS}", 2)
+    with pytest.raises(ValueError, match="refused"):
+        report_mod.seeds("workflow_dispatch", "0-3\nfoo=bar", 2)
+
+
+def test_a_dispatch_is_bounded_before_its_seeds_are_built() -> None:
+    """A range far past the bound is refused without building it: the bound reads the text first."""
+    tracemalloc.start()
+    try:
+        with pytest.raises(ValueError, match="at most"):
+            report_mod.seeds("workflow_dispatch", "0-300000", 2)
+        peak = tracemalloc.get_traced_memory()[1]
+    finally:
+        tracemalloc.stop()
+    assert peak < 1_000_000, peak
+
+
+_SOAK_CASE = '<testcase classname="t" name="test_soak_the_close_count_under_concurrency[{form}-seed{seed}]">{body}</testcase>'
+_CASE = '<testcase classname="t" name="{name}">{body}</testcase>'
+_KNOWN = (
+    '<properties><property name="soak_known" value="{shape}"/></properties>'
+    '<skipped type="pytest.xfail" message="known soak finding: {shape} (§12: x)">r</skipped>'
+)
+
+
+def _xml(bodies: list[str], wiring: dict[str, str] | None = None) -> str:
+    cases = []
+    forms = report_mod.FORMS_SOAKED
+    for index, body in enumerate(bodies):
+        cases.append(_SOAK_CASE.format(form=forms[index % 3], seed=index // 3, body=body))
+    for name in report_mod.WIRING:
+        if wiring is None or name in wiring:
+            cases.append(_CASE.format(name=name, body=(wiring or {}).get(name, "")))
+    return f'<?xml version="1.0"?><testsuites><testsuite name="pytest">{"".join(cases)}</testsuite></testsuites>'
+
+
+SWAP = soak_known.SWAP_ARM.name
+CEIL = soak_ceilings.ceiling_of(soak_known.SWAP_ARM.name)
+
+
+@pytest.mark.parametrize(
+    ("bodies", "seeds", "wiring", "status", "says"),
+    [
+        ([""] * 6, "0-1", None, 0, "clean: 6; known: 0; new: 0"),
+        ([_KNOWN.format(shape=SWAP)] + [""] * 5, "0-1", None, 0, "1 x " + SWAP),
+        (
+            ['<failure message="CloseBroken:repeat@1">r</failure>'] + [""] * 5,
+            "0-1",
+            None,
+            0,
+            "LOG_FOUNDRY_MODEL_SEEDS=0",
+        ),
+        ([""] * 5, "0-1", None, 1, "5 soak items ran where 6 were asked"),
+        (
+            ['<skipped type="pytest.skip" message="skip">r</skipped>'] * 6,
+            "0-1",
+            None,
+            1,
+            "skipped or marked",
+        ),
+        (
+            ['<skipped type="pytest.xfail" message="flaky">r</skipped>'] + [""] * 5,
+            "0-1",
+            None,
+            1,
+            "skipped or marked",
+        ),
+        (
+            ['<skipped type="pytest.xfail" message="known soak finding: x">r</skipped>'] + [""] * 5,
+            "0-1",
+            None,
+            1,
+            "skipped or marked",
+        ),
+        (
+            [
+                '<properties><property name="soak_known" value="x"/></properties>'
+                '<skipped type="pytest.xfail" message="flaky">r</skipped>'
+            ]
+            + [""] * 5,
+            "0-1",
+            None,
+            1,
+            "skipped or marked",
+        ),
+        ([""] * 6, "0-1", {report_mod.WIRING[0]: ""}, 1, "Wiring"),
+        (
+            [""] * 6,
+            "0-1",
+            {n: '<failure message="x">r</failure>' for n in report_mod.WIRING},
+            1,
+            "Wiring",
+        ),
+        (
+            [_KNOWN.format(shape=SWAP)] * (CEIL + 1) + [""] * (66 - CEIL - 1),
+            "0-21",
+            None,
+            1,
+            "Ceiling broken",
+        ),
+        (
+            [_KNOWN.format(shape=SWAP)] * CEIL + [""] * (66 - CEIL),
+            "0-21",
+            None,
+            0,
+            f"{CEIL} x {SWAP}",
+        ),
+    ],
+    ids=[
+        "clean",
+        "known",
+        "new-with-its-rerun",
+        "one-short",
+        "all-skipped",
+        "xfail-not-known",
+        "xfail-known-text-without-the-property",
+        "xfail-with-the-property-without-the-text",
+        "wiring-absent",
+        "wiring-failed",
+        "over-the-ceiling",
+        "at-the-ceiling",
+    ],
+)
+def test_the_report(
+    tmp_path: pathlib.Path,
+    bodies: list[str],
+    seeds: str,
+    wiring: dict[str, str] | None,
+    status: int,
+    says: str,
+) -> None:
+    """The floor, the wiring and the ceiling each set the exit status, and say why."""
+    xml = tmp_path / "soak.xml"
+    xml.write_text(_xml(bodies, wiring), encoding="utf-8")
+    text, got = report_mod.report(xml, seeds)
+    assert (got, says in text) == (status, True), text
