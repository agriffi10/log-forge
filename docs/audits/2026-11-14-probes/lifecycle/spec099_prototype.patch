@@ -0,0 +1,74 @@
+name: Model soak
+
+# SPEC-099 prototype: the model test's close count under four callers, every night, on `main`.
+on:
+  schedule:
+    - cron: "37 9 * * *"
+  pull_request:
+    paths:
+      - ".github/workflows/model-soak.yml"
+      - ".github/actions/install-poetry/**"
+      - "scripts/model-soak-report.py"
+      - "tests/soak_known.py"
+      - "tests/soak_ceilings.py"
+      - "tests/model_oracles.py"
+      - "tests/test_invariants_model.py"
+      - "tests/conftest.py"
+      - "pyproject.toml"
+      - "poetry.lock"
+  workflow_dispatch:
+    inputs:
+      seeds:
+        description: "LOG_FOUNDRY_MODEL_SEEDS for this run, at most 10,000 seeds; empty for this run's window"
+        required: false
+        default: ""
+
+permissions:
+  contents: read
+
+concurrency:
+  group: model-soak-${{ github.event_name == 'pull_request' && github.ref || github.run_id }}
+  cancel-in-progress: true
+
+jobs:
+  soak:
+    name: soak the close count
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+
+      - name: Set up Python
+        uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
+        with:
+          python-version: "3.12"
+
+      - name: Install Poetry
+        uses: ./.github/actions/install-poetry
+
+      - name: Install dependencies
+        run: poetry install --with dev
+
+      - name: Choose the seeds
+        id: seeds
+        env:
+          ASKED: ${{ inputs.seeds }}
+          EVENT: ${{ github.event_name }}
+          RUN_NUMBER: ${{ github.run_number }}
+        run: |
+          seeds="$(poetry run python scripts/model-soak-report.py seeds --event "$EVENT" --asked "$ASKED" --run-number "$RUN_NUMBER")"
+          echo "seeds=$seeds" >> "$GITHUB_OUTPUT"
+
+      - name: Soak
+        env:
+          LOG_FOUNDRY_MODEL_SOAK: "1"
+          LOG_FOUNDRY_MODEL_SEEDS: ${{ steps.seeds.outputs.seeds }}
+        run: poetry run pytest tests/test_invariants_model.py -k "test_soak_the_close_count_under_concurrency or test_the_soak_is_wired or test_the_soak_records_the_worker_path or test_a_name_the_soak_cannot_wrap_fails_it" -p no:cacheprovider -rfEx --junitxml=soak.xml
+
+      - name: Report
+        if: always()
+        env:
+          SEEDS: ${{ steps.seeds.outputs.seeds }}
+        run: poetry run python scripts/model-soak-report.py report soak.xml "$SEEDS" --summary "$GITHUB_STEP_SUMMARY"
diff --git a/scripts/model-soak-report.py b/scripts/model-soak-report.py
