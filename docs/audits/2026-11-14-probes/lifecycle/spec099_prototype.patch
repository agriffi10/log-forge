+#!/bin/sh
+# SPEC-099: the PR queue's reading of the nightly soak's verdict, its clearing branch and the hook.
+#
+# A stub `gh` on PATH answers three calls from the environment:
+#   gh run list ... --event schedule ...  -> $GH_SCHED, "<run id> <attempts> <head sha> [status]" a line,
+#                                            newest first; with --status completed, only completed ones
+#   gh run list ... (any other)           -> $GH_RUNS, "<head sha> <status> <conclusion> <workflow>" a line
+#   gh api .../runs/<id>/attempts/<n>     -> the line of $GH_ATT reading "<id> <n> <conclusion> <time>"
+# HEAD in either list is the trunk's head sha. GH_FAIL fails every call, GH_API_FAIL only `gh api`.
+# Every case asserts where it lands AND why: the state or exit, and a line of what the queue said,
+# including the cases that must stay silent. Needs git and bash; no network, no GitHub.
+set -u
+HERE="$(cd "$(dirname "$0")" && pwd)"
+T="$(mktemp -d)"; trap 'rm -rf "$T"' EXIT
+fails=0
+check() { if [ "$2" = "$3" ]; then echo "ok    $1"; else echo "FAIL  $1: got [$2] want [$3]"; fails=$((fails+1)); fi; }
+has()   { case "$2" in *"$3"*) echo "ok    $1";; *) echo "FAIL  $1: [$3] not in [$(printf '%s' "$2" | tr '\n' '|' | cut -c1-200)]"; fails=$((fails+1));; esac; }
+hasnt() { case "$2" in *"$3"*) echo "FAIL  $1: [$3] in [$(printf '%s' "$2" | tr '\n' '|' | cut -c1-200)]"; fails=$((fails+1));; *) echo "ok    $1";; esac; }
+
+mkdir -p "$T/bin" "$T/q/tickets"
+cat > "$T/bin/gh" <<'GH'
+#!/bin/sh
+[ -n "${GH_FAIL:-}" ] && { echo "gh: stub failure" >&2; exit 1; }
+head="$(git -C "$REPO_FOR_STUB" ls-remote origin refs/heads/main | cut -f1)"
+case "$1" in
+  run) case " $* " in
+         *" --status completed "*) printf '%s\n' "${GH_SCHED:-}" | awk '$4=="" || $4=="completed" {print $1" "$2" "$3}' | sed "s/ HEAD\$/ $head/" ;;
+         *" schedule "*) printf '%s\n' "${GH_SCHED:-}" | awk '{print $1" "$2" "$3}' | sed "s/ HEAD\$/ $head/" ;;
+         *)              printf '%s\n' "${GH_RUNS:-}" | sed "s/^HEAD /$head /" ;;
+       esac ;;
+  api) [ -n "${GH_API_FAIL:-}" ] && { echo "gh: api failure" >&2; exit 1; }
+       id="$(printf '%s' "$2" | sed -n 's#.*/runs/\([0-9]*\)/attempts/\([0-9]*\)$#\1#p')"
+       n="$(printf '%s' "$2" | sed -n 's#.*/runs/\([0-9]*\)/attempts/\([0-9]*\)$#\2#p')"
+       line="$(printf '%s\n' "${GH_ATT:-}" | awk -v i="$id" -v n="$n" '$1==i && $2==n {print $3" "$4; exit}')"
+       [ -n "$line" ] || { echo "HTTP 404" >&2; exit 1; }
