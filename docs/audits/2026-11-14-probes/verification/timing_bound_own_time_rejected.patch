+_WAIT_FILES: dict[int, int] = {}
+"""An open descriptor on each live thread's ``schedstat``, by native thread id."""
+
+_WAIT_LOCK = threading.Lock()
+"""Held for one reading, so no reader closes a descriptor another is about to read."""
