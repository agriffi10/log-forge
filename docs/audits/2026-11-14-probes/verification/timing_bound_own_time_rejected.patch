+def _cpu_waits() -> Waits | None:
+    """Reads how long each thread of this process has waited runnable for a CPU, and how often.
+
+    From ``/proc/self/task/<tid>/schedstat``, which Linux keeps per thread: its second field
+    counts nanoseconds only while a thread is runnable and not running, so a thread blocked on a
+    lock, a wait or a sleep adds nothing to it, and its third counts the times the thread was
+    given a CPU. The threads are ``threading.enumerate()``'s, which covers the actors, the
+    library's worker and its closers, and the calling thread by its own id, because on Python
+    3.12 a forked child's ``Thread.native_id`` is still its parent thread's.
+
+    Returns:
+      The reading, or ``None`` where there is nothing to read (macOS, or a kernel built without
+      scheduler accounting), which :func:`model_oracles.starved` reads as no starvation at all,
+      so the bound is then the plain elapsed one.
+    """
+    if not _COUNTS_WAITS:
+        return None
+    began = time.monotonic()
+    waits: dict[int, tuple[int, int]] = {}
+    with _WAIT_LOCK:
+        live = {thread.native_id for thread in threading.enumerate()} - {None}
+        live.add(threading.get_native_id())
+        for tid in live:
+            fd = _WAIT_FILES.get(tid)
+            if fd is None:
+                try:
+                    fd = os.open(f"/proc/self/task/{tid}/schedstat", os.O_RDONLY)
+                except OSError:
