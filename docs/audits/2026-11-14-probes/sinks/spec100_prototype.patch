+"""FIFO ids, the per-run entry cache and the group hold that SQSSink and SNSSink share (SPEC-100)."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from dataclasses import dataclass
+from typing import NamedTuple, cast
+
+from log_foundry import _diag
+from log_foundry.sinks._args import require_callable
+from log_foundry.sinks._engine import run_context
+from log_foundry.sinks.verdict import Outcome
+
+DEFAULT_GROUP_ID = "log-foundry"
+"""Fallback group for an event carrying no usable ``trace_id`` — never send an empty group id."""
+
+MAX_ID_LEN = 128
+"""The SQS and SNS maximum length for ``MessageGroupId`` and ``MessageDeduplicationId``."""
+
+GroupIdSource = str | Callable[[dict[str, object]], str] | None
+"""What ``message_group_id=`` accepts: a constant, a callable, or ``None`` for ``trace_id``."""
+
+DedupIdSource = Callable[[dict[str, object]], str] | None
+"""What ``message_deduplication_id=`` accepts: a callable, or ``None`` for ``log_id``."""
+
+
+def judge(
+    owner: str, kind: str, name: str, destination: str, fifo: object, group: object, dedup: object
+) -> bool:
+    """Judges the three FIFO arguments against the destination and returns the sink's type.
+
+    The types are judged first, the id sources' and then ``fifo``'s, and then the values.
+    ``fifo`` is asked its type, never its truth: anything but a ``bool`` or ``None`` is refused.
+    ``bool`` cannot be subclassed, so no subclass reaches the test. ``fifo=True`` on a
+    destination whose name does not end in ``.fifo`` is refused, because AWS requires every FIFO
+    queue and topic name to end so and that sink could never deliver. ``fifo=False`` on a
+    ``.fifo`` name is accepted: AWS does not say a standard name cannot end so (invariant 13's
+    recorded exception). An id argument passed to a sink that is not FIFO is refused, since a
+    standard destination never reads it.
+
+    Args:
+      owner: The constructing class's name.
+      kind: ``"queue"`` or ``"topic"``, for the message.
+      name: The destination's keyword, ``queue_url`` or ``topic_arn``, for the message.
+      destination: The queue URL or topic ARN.
+      fifo: ``fifo`` as passed.
+      group: ``message_group_id`` as passed.
+      dedup: ``message_deduplication_id`` as passed.
+
+    Returns:
+      Whether the sink is FIFO.
+
+    Raises:
+      TypeError: For a ``fifo`` that is neither a ``bool`` nor ``None``, or an id source outside
+        its declared type.
+      ValueError: For a blank constant group id, ``fifo=True`` on a name not ending in ``.fifo``,
+        or an id argument on a sink that is not FIFO.
+    """
+    require_callable(group, "message_group_id", owner, text=True)
+    require_callable(dedup, "message_deduplication_id", owner)
+    if fifo is not None and not issubclass(type(fifo), bool):
+        raise TypeError(
+            f"{owner} fifo must be a bool or None, not "
+            f"{_diag._STR_STR(_diag._STORED_NAME(type(fifo)))}"
+        )
+    if issubclass(type(group), str) and not _diag._STR_STR(cast("str", group)).strip():
+        raise ValueError(
+            "message_group_id must be a non-empty string; pass None to group by trace_id"
+        )
+    suffixed = destination.endswith(".fifo")
+    if fifo and not suffixed:
+        raise ValueError(
+            f"{owner} fifo=True needs a {name} ending in .fifo: AWS requires every FIFO {kind} "
+            "name to end so"
+        )
+    is_fifo = suffixed if fifo is None else bool(fifo)
+    if not is_fifo:
+        names = [
+            arg
+            for arg, value in (("message_group_id", group), ("message_deduplication_id", dedup))
+            if value is not None
+        ]
+        if names:
+            raise ValueError(
+                f"{owner} cannot apply {', '.join(names)} to a standard {kind}; drop it, or use "
+                f"a {name} ending in .fifo"
+            )
+    return is_fifo
+
+
+def bounded(raw: str, fallback: str) -> str:
+    """Normalizes a derived id, falling back when blank and truncating when over-long.
+
+    Args:
+      raw: The derived id.
+      fallback: What a blank id becomes.
+
+    Returns:
+      The id, at most the maximum length.
+
+    Raises:
+      None.
+    """
+    cleaned = raw.strip()
+    if not cleaned:
+        return fallback
+    return cleaned[:MAX_ID_LEN]
+
+
+def group_id(source: GroupIdSource, event: dict[str, object]) -> str:
+    """Resolves one event's ``MessageGroupId``: the constant, the callable's answer, or trace_id.
+
+    Args:
+      source: The sink's ``message_group_id``.
+      event: The event.
+
+    Returns:
+      The group id.
+
+    Raises:
+      Exception: A caller-supplied callable's own exception.
+    """
+    if issubclass(type(source), str):
+        raw = _diag._STR_STR(cast("str", source))
+    elif source is not None:
+        raw = cast("Callable[[dict[str, object]], str]", source)(event)
+    else:
+        raw = str(event.get("trace_id", ""))
+    return bounded(raw, DEFAULT_GROUP_ID)
+
+
+def dedup_id(source: DedupIdSource, event: dict[str, object]) -> str:
+    """Resolves one event's ``MessageDeduplicationId``: the callable's answer or ``log_id``.
+
+    Args:
+      source: The sink's ``message_deduplication_id``.
+      event: The event.
+
+    Returns:
+      The deduplication id: a minted UUID when the answer is blank, and the SHA-256 hex digest
+      of the stripped answer when it is longer than ``MAX_ID_LEN``, so two answers sharing their
+      first 128 characters never share an id (SPEC-100).
+
+    Raises:
+      Exception: A caller-supplied callable's own exception.
+    """
+    raw = source(event) if source is not None else str(event.get("log_id", ""))
+    cleaned = raw.strip()
+    if len(cleaned) > MAX_ID_LEN:
+        import hashlib
+
+        return hashlib.sha256(cleaned.encode("utf-8", "surrogatepass")).hexdigest()
+    if cleaned:
+        return cleaned
+    from log_foundry.ids import new_log_id
+
+    return new_log_id()
+
+
+class Prepared(NamedTuple):
+    """One event serialized and costed, with its FIFO ids resolved, at its place in the round.
+
+    Attributes:
+      position: The event's position in the round's batch.
+      body: The serialized event.
+      group_id: The resolved ``MessageGroupId``, or ``None``.
+      dedup_id: The resolved ``MessageDeduplicationId``, or ``None``.
+      size: The costed bytes.
+    """
+
+    position: int
+    body: str
+    group_id: str | None
+    dedup_id: str | None
+    size: int
+
+
+class Plan(NamedTuple):
+    """One round's prepared entries and drops.
+
+    Attributes:
+      prepared: The sendable entries, in batch order.
+      dropped: Each dropped position and its reason.
+      refused: The first id callable's exception when every event's raised.
+    """
+
+    prepared: list[Prepared]
+    dropped: dict[int, str]
+    refused: Exception | None
+
+
+@dataclass(slots=True)
+class Entry:
+    """One event occurrence's prepared entry or drop reason, kept for its delivery run.
+
+    Attributes:
+      body: The serialized event, or ``""`` for a drop.
+      group_id: The resolved ``MessageGroupId``, or ``None``.
+      dedup_id: The resolved ``MessageDeduplicationId``, or ``None``.
+      size: The costed bytes.
+      drop: The drop reason, or ``None``.
+      error: The id callable's exception, for an id failure.
+      landed: Whether the service has accepted this occurrence.
+    """
+
+    body: str = ""
+    group_id: str | None = None
+    dedup_id: str | None = None
+    size: int = 0
+    drop: str | None = None
+    error: Exception | None = None
+    landed: bool = False
+
+
+def prepare(
+    body: str | None,
+    event: dict[str, object],
+    *,
+    fifo: bool,
+    group: GroupIdSource,
+    dedup: DedupIdSource,
+    limit: int,
+) -> Entry:
+    """Prepares one event occurrence's entry, or decides its drop.
+
+    Args:
+      body: The encoded body, or ``None`` when it could not be encoded.
+      event: The event.
+      fifo: Whether the destination is FIFO.
+      group: The group source.
+      dedup: The dedup source.
+      limit: The message limit the costed size is held to.
+
+    Returns:
+      The entry.
+
+    Raises:
+      None. A ``BaseException`` from a caller's callable propagates.
+    """
+    if body is None:
+        return Entry(drop="unencodable")
+    size = len(body.encode("utf-8"))
+    gid: str | None = None
+    did: str | None = None
+    if fifo:
+        try:
+            gid = group_id(group, event)
+            did = dedup_id(dedup, event)
+        except Exception as err:
+            return Entry(drop="id failure", error=err)
+        size += len(gid.encode("utf-8")) + len(did.encode("utf-8"))
+    if size > limit:
+        return Entry(size=size, drop="oversize")
+    return Entry(body=body, group_id=gid, dedup_id=did, size=size)
+
+
+def plan_round(
+    owner: object,
+    batch: list[dict[str, object]],
+    bodies: dict[int, str],
+    prepare_one: Callable[[dict[str, object], str | None], Entry],
+) -> Plan:
+    """Prepares each event once per run and keeps the entry in the run's notes by identity.
+
+    Args:
+      owner: The sink.
+      batch: The round's events.
+      bodies: Each encodable position's body, from the sink's own ``encode_round`` call, which
+        stays in the sink's module so ``tests/test_encode.py``'s roster still derives the sink.
+      prepare_one: The sink's ``_prepare``.
+
+    Returns:
+      The round's plan; ``notes(owner)["prepared_round"]`` holds each position's entry.
+
+    Raises:
+      None. A ``BaseException`` from a caller's callable propagates.
+    """
+    notes = run_context().notes(owner)
+    cache = cast(
+        "dict[int, tuple[dict[str, object], list[Entry]]]", notes.setdefault("prepared", {})
+    )
+    round_entries: list[Entry | None] = [None] * len(batch)
+    notes["prepared_round"] = round_entries
+    taken: dict[int, int] = {}
+    prepared: list[Prepared] = []
+    dropped: dict[int, str] = {}
+    failures = 0
+    first: Exception | None = None
+    for position, event in enumerate(batch):
+        held = cache.get(id(event))
+        if held is None or held[0] is not event:
+            held = (event, [])
+            cache[id(event)] = held
+        live = [cached for cached in held[1] if not cached.landed]
+        skip = taken.get(id(event), 0)
+        taken[id(event)] = skip + 1
+        if skip < len(live):
+            entry = live[skip]
+        else:
+            entry = prepare_one(event, bodies.get(position))
+            held[1].append(entry)
+        round_entries[position] = entry
+        if entry.drop is not None:
+            dropped[position] = entry.drop
+            if entry.drop == "id failure":
+                failures += 1
+                first = first if first is not None else entry.error
+            continue
+        prepared.append(Prepared(position, entry.body, entry.group_id, entry.dedup_id, entry.size))
+    refused = first if batch and failures == len(batch) else None
+    return Plan(prepared, dropped, refused)
+
+
+def hold(chunk: list[Prepared], blocked: set[str], sends: list[int], limit: int) -> list[bool]:
+    """Decides, at send time, which entries of a FIFO chunk wait behind their group (SPEC-074).
+
+    Args:
+      chunk: The chunk's entries, in batch order.
+      blocked: Groups blocked so far this round, updated in place.
+      sends: Each entry's sends so far this run.
+      limit: ``max_retries + 1``.
+
+    Returns:
+      Per entry, whether it is held.
+
+    Raises:
+      None.
+    """
+    held: list[bool] = []
+    for item, count in zip(chunk, sends, strict=True):
+        group = item.group_id or ""
+        if group in blocked:
+            held.append(True)
+            continue
+        held.append(False)
+        if count and count + 1 < limit:
+            blocked.add(group)
+    return held
+
+
+def block(
+    sent: list[Prepared], fates: list[Outcome], sends: list[int], blocked: set[str], limit: int
+) -> None:
+    """Blocks the group of every sent entry that neither landed nor used its sends.
+
+    Args:
+      sent: The entries a call carried.
+      fates: The round's outcomes, by position.
+      sends: Each sent entry's sends so far this run, this call's included.
+      blocked: Groups blocked so far this round, updated in place.
+      limit: ``max_retries + 1``.
+
+    Returns:
+      None.
+
+    Raises:
+      None.
+    """
+    for item, count in zip(sent, sends, strict=True):
+        if fates[item.position] is not Outcome.ACCEPTED and count < limit:
+            blocked.add(item.group_id or "")
