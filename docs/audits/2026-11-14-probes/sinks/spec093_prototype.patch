+def _peer_state(sock: socket.socket) -> str:
+    """Reports what a held TCP connection shows of its peer: ``open``, ``fin`` or ``reset``.
+
+    A pending socket error (``SO_ERROR``) is a reset, then a zero-timeout readiness check and a
+    one-byte peek: readable with nothing to read is a FIN, and a peek that raises ``OSError`` is a
+    reset. A check that cannot be made reads as open.
+
+    Args:
+      sock: The held socket.
+
+    Returns:
+      ``open``, ``fin`` or ``reset``.
+
+    Raises:
+      None.
+    """
+    try:
+        if sock.getsockopt(socket.SOL_SOCKET, socket.SO_ERROR):
+            return "reset"
+        try:
+            readable = bool(select.select([sock], [], [], 0)[0])
+        except ValueError:
+            poller = select.poll()
+            poller.register(sock, select.POLLIN)
+            readable = bool(poller.poll(0))
+        if not readable:
+            return "open"
+        return "fin" if sock.recv(1, socket.MSG_PEEK) == b"" else "open"
+    except OSError:
+        return "reset"
+    except Exception:
+        return "open"
+
