+
+def runs_held(fn: Callable[_P, _R]) -> Callable[_P, _R]:
+    """PROTOTYPE (SPEC-097): marks a public call that runs this thread's held calls at its end.
+
+    Typed with a ``ParamSpec`` so the wrapped call keeps its signature for a typed consumer.
+
+    Args:
+      fn: The public call.
+
+    Returns:
+      The wrapped call, carrying ``__log_foundry_runs_held__``.
+
+    Raises:
+      None.
+    """
+    import functools
+
+    @functools.wraps(fn)
+    def held_runner(*args: _P.args, **kwargs: _P.kwargs) -> _R:
+        try:
+            return fn(*args, **kwargs)
+        finally:
+            _run_waiting()
+
+    held_runner.__log_foundry_runs_held__ = True  # type: ignore[attr-defined]
+    return held_runner
