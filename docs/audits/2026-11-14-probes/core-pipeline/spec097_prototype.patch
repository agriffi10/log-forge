+def defer_to_section_end(call: object) -> None:
+    """PROTOTYPE (SPEC-097): runs a call at the end of the library call this thread is inside.
+
+    Args:
+      call: A callable taking no arguments.
+
+    Returns:
+      None.
+
+    Raises:
+      None.
+    """
+    waiting = getattr(_sections, "waiting", None)
+    if waiting is None:
+        waiting = []
+        _sections.waiting = waiting
+    waiting.append(call)
+
+
+def _run_waiting() -> bool:
+    """PROTOTYPE (SPEC-097): runs the calls held on this thread, once it holds no library lock.
+
+    Args:
+      None.
+
+    Returns:
+      Whether any call ran.
+
+    Raises:
+      None.
+    """
+    waiting = getattr(_sections, "waiting", None)
+    if not waiting or in_section():
+        return False
+    _sections.waiting = []
+    for call in waiting:
+        call()
+    return True
+
+
+_P = typing.ParamSpec("_P")
+_R = typing.TypeVar("_R")
