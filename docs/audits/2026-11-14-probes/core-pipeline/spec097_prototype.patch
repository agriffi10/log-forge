+def in_section() -> bool:
+    """PROTOTYPE (SPEC-097): whether this thread holds a library lock, or is inside a flush's wait.
+
+    Args:
+      None.
+
+    Returns:
+      Whether a lifecycle call made here must be deferred.
+
+    Raises:
+      None.
+    """
+    if getattr(_sections, "flushing", 0):
+        return True
+    return any(lock._is_owned() for lock in _library_locks())  # type: ignore[attr-defined]
